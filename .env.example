# Copiar a .env y completar. Estas creds sólo se usan en modo single-tenant
# (HWC_REQUIRE_PER_REQUEST_CREDS=0). En multi-tenant, la app manda las creds
# del usuario por header en cada call y estas quedan vacías.

# Cuenta de fallback del operador (modo single-tenant)
HUAWEI_ACCESS_KEY=
HUAWEI_SECRET_KEY=
HUAWEI_REGION=la-south-2

# 1 = el contenedor exige creds por header en cada request (no cae a las de arriba).
# Activarlo junto con MCP_HUAWEI_PER_REQUEST_CREDS=1 en la app que lo consume.
HWC_REQUIRE_PER_REQUEST_CREDS=0
